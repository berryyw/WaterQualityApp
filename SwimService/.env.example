NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/swim_service?schema=public"
REDIS_ENABLED="false"
REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET="replace-with-a-secure-access-secret"
JWT_REFRESH_SECRET="replace-with-a-secure-refresh-secret"
CORS_ALLOWED_ORIGINS="http://localhost:4173,http://127.0.0.1:4173"
STORAGE_PROVIDER="local"
SERVICE_PUBLIC_BASE_URL="http://localhost:3000"
OSS_ENDPOINT="https://oss-cn-hongkong.aliyuncs.com"
OSS_FORCE_PATH_STYLE="false"
OSS_REGION="cn-hongkong"
OSS_BUCKET="swim-service-dev"
OSS_ACCESS_KEY_ID="replace-me"
OSS_ACCESS_KEY_SECRET="replace-me"
OSS_CDN_BASE_URL="https://cdn.example.com"
OSS_PUBLIC_BASE_URL="https://cdn.example.com"
EMAIL_PROVIDER="log"
EMAIL_FROM="noreply@example.com"
EMAIL_LOCAL_OUTPUT_DIR="runtime/emails"
EMAIL_SMTP_HOST="smtp.example.com"
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_SECURE="false"
EMAIL_SMTP_USER="replace-me"
EMAIL_SMTP_PASSWORD="replace-me"
EMAIL_SMTP_DIAGNOSTIC="false"

AMAP_WEB_KEY="replace-me-amap-web-service-key"
